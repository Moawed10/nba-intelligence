# Copy to backend/.env and adjust. Every setting is optional; defaults suit local development.
NBA_DATABASE_URL=postgresql+psycopg:///nba_intelligence
NBA_DB_POOL_SIZE=5
NBA_DB_MAX_OVERFLOW=5
NBA_DB_CONNECT_TIMEOUT_SECONDS=5
NBA_DB_POOL_TIMEOUT_SECONDS=10
NBA_API_STATEMENT_TIMEOUT_MS=15000
NBA_LOG_LEVEL=INFO
NBA_LOG_JSON=true
# API. CORS stays off in production: the frontend calls the API through its own /api/v1 proxy.
NBA_CORS_ORIGINS=[]
NBA_API_DOCS_ENABLED=true
# Disable only to benchmark uncached query paths
NBA_API_CACHE_ENABLED=true
# Forecast rate limits, counted per API process
NBA_PREDICTION_RATE_PER_MINUTE=60
NBA_PREDICTION_RATE_BURST=20
NBA_PREDICTION_RATE_GLOBAL_PER_MINUTE=600
NBA_TRUSTED_PROXY_IPS=["127.0.0.1","::1"]
# stats.nba.com client
NBA_STATS_REQUEST_INTERVAL_SECONDS=1.0
NBA_STATS_TIMEOUT_SECONDS=30
NBA_STATS_MAX_ATTEMPTS=5
NBA_STATS_CACHE_DIR=.cache/nba_stats
# Tests. Read from the shell environment, not from this file.
NBA_TEST_DATABASE_URL=postgresql+psycopg:///nba_intelligence_test
